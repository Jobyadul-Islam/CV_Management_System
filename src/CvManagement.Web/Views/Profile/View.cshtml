@model CvManagement.Web.ViewModels.Profile.ProfileViewViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Model.DisplayName;
}

@{ var isAdmin = User.IsInRole("Administrator"); }
<div class="d-flex justify-content-between align-items-start mb-3">
    <h1 class="h3 mb-0">@Model.DisplayName</h1>
    @if (isAdmin)
    {
        <a asp-controller="Profile" asp-action="Index" asp-route-userId="@Model.UserId" class="btn btn-outline-secondary btn-sm">@Localizer["ProfileView_EditAsAdmin"]</a>
    }
</div>

<div class="mb-3">
    <img src="@Url.Action("Badges", "Profile", new { userId = Model.UserId })" alt="@Localizer["Profile_Achievements"]" class="d-block" style="max-width:100%" />
</div>

<div class="row">
    <div class="col-lg-6">
        <h2 class="h5">@Localizer["ProfileView_Profile"]</h2>
        @foreach (var field in Model.MeAttributes)
        {
            <partial name="_AttributeValueDisplay" model="field" />
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h5">@Localizer["ProfileView_PublishedCvs"]</h2>
        @if (Model.PublishedCvs.Count == 0)
        {
            <p class="text-secondary">@Localizer["ProfileView_NoPublishedCvs"]</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var cv in Model.PublishedCvs)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <a asp-controller="Cv" asp-action="Details" asp-route-id="@cv.Id">@cv.PositionTitle</a>
                        <span>&#9733; @cv.LikeCount</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
