@model IReadOnlyList<CvManagement.Web.ViewModels.Attribute.AttributeListItemViewModel>
@using CvManagement.Web.ViewModels.Shared
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Attributes_Title"];
    var categories = (IReadOnlyList<CvManagement.Web.Domain.AttributeCategory>)ViewBag.Categories;
    var prefix = (string?)ViewBag.Prefix;
    var categoryId = (int?)ViewBag.CategoryId;

    var actions = new List<ToolbarAction>
    {
        new(Localizer["Common_Edit"], Url.Action("Edit", "Attributes")! + "/{id}", "get", MinSelected: 1, MaxSelected: 1),
        new(Localizer["Common_Delete"], Url.Action("Delete", "Attributes")!, "post", MinSelected: 1, Confirm: Localizer["Attributes_DeleteConfirm"], CssClass: "btn-outline-danger")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Localizer["Attributes_Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Attributes_New"]</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="prefix" value="@prefix" class="form-control" placeholder="@Localizer["Attributes_SearchPlaceholder"]" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">@Localizer["Attributes_AllCategories"]</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(category.Id == categoryId)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">@Localizer["Common_Filter"]</button>
    </div>
</form>

@await Component.InvokeAsync("SelectableTableToolbar", new { tableId = "attributes-table", actions })

<div class="table-responsive">
    <table id="attributes-table" class="table table-hover align-middle selectable-table" data-toolbar="attributes-table-toolbar">
        <thead>
            <tr>
                <th style="width:2rem"><input type="checkbox" class="select-all form-check-input" /></th>
                <th>@Localizer["Attributes_ColName"]</th>
                <th>@Localizer["Attributes_ColCategory"]</th>
                <th>@Localizer["Attributes_ColType"]</th>
                <th>@Localizer["Attributes_ColUsedIn"]</th>
                <th>@Localizer["Common_Updated"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id">
                    <td><input type="checkbox" class="row-select form-check-input" value="@item.Id" /></td>
                    <td>
                        @item.Name
                        @if (item.IsBuiltIn)
                        {
                            <span class="badge bg-secondary ms-1">@Localizer["Attributes_BuiltIn"]</span>
                        }
                    </td>
                    <td>@item.CategoryName</td>
                    <td>@Html.DisplayFor(_ => item.DataType)</td>
                    <td>@item.PositionUsageCount @Localizer["Attributes_UsedInPositions"]</td>
                    <td>@item.UpdatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">@Localizer["Attributes_Empty"]</td></tr>
            }
        </tbody>
    </table>
</div>
