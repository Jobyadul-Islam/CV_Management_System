@model CvManagement.Web.ViewModels.Attribute.AttributeFormViewModel
@inject IStringLocalizer<SharedResource> Localizer
@* Rendered from the page's @section Scripts (see Create/Edit), i.e. after the layout's jQuery,
   Bootstrap and shared scripts -- inline in the form they ran too early and crashed. *@
<partial name="_ValidationScriptsPartial" />
<script>
        (function () {
            var dataTypeSelect = document.getElementById("dataTypeSelect");
            var optionsSection = document.getElementById("optionsSection");
            var optionsList = document.getElementById("optionsList");
            var template = document.getElementById("optionRowTemplate");
            var lengthTuningSection = document.getElementById("lengthTuningSection");
            var numericTuningSection = document.getElementById("numericTuningSection");
            var oneOfManyValue = "@((int)CvManagement.Web.Models.Enums.AttributeDataType.OneOfMany)";
            var stringValue = "@((int)CvManagement.Web.Models.Enums.AttributeDataType.String)";
            var textValue = "@((int)CvManagement.Web.Models.Enums.AttributeDataType.Text)";
            var numericValue = "@((int)CvManagement.Web.Models.Enums.AttributeDataType.Numeric)";
            var rowIndex = optionsList.querySelectorAll(".option-row").length;

            function refreshVisibility() {
                var value = dataTypeSelect.value;
                optionsSection.style.display = value === oneOfManyValue ? "" : "none";
                lengthTuningSection.style.display = (value === stringValue || value === textValue) ? "" : "none";
                numericTuningSection.style.display = value === numericValue ? "" : "none";
            }

            function addRow(id, rowVersion, label) {
                var html = template.innerHTML.replace(/__index__/g, rowIndex++);
                var wrapper = document.createElement("div");
                wrapper.innerHTML = html.trim();
                var row = wrapper.firstElementChild;
                var hiddenInputs = row.querySelectorAll("input[type=hidden]");
                hiddenInputs[0].value = id || 0;
                hiddenInputs[1].value = rowVersion || "";
                row.querySelector("input[type=text]").value = label || "";
                row.querySelector(".remove-option-btn").addEventListener("click", function () { row.remove(); });
                optionsList.appendChild(row);
            }

            document.getElementById("addOptionBtn").addEventListener("click", function () { addRow(0, "", ""); });
            dataTypeSelect.addEventListener("change", refreshVisibility);

            var existingOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Options));
            existingOptions.forEach(function (o) { addRow(o.Id, o.RowVersion, o.Label); });
            if (existingOptions.length === 0 && dataTypeSelect.value === oneOfManyValue) { addRow(0, "", ""); }

            refreshVisibility();
        })();
</script>
