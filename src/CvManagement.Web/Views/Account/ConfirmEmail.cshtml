@model bool
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Model ? Localizer["Auth_EmailConfirmedTitle"] : Localizer["Auth_ConfirmFailedTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            @if (Model)
            {
                <h1 class="auth-title text-success">@Localizer["Auth_EmailConfirmedTitle"]</h1>
                <p class="auth-subtitle">@Localizer["Auth_EmailConfirmedText"]</p>
                <a asp-action="Login" class="btn btn-auth">@Localizer["Account_LoginButton"]</a>
            }
            else
            {
                <h1 class="auth-title text-danger">@Localizer["Auth_ConfirmFailedTitle"]</h1>
                <p class="auth-subtitle">@Localizer["Auth_ConfirmFailedText"]</p>
                <a asp-action="Login" class="btn btn-auth">@Localizer["Auth_BackToSignIn"]</a>
            }
        </section>
    </div>
</div>
