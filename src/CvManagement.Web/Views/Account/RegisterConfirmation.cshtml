@model CvManagement.Web.ViewModels.Account.RegisterConfirmationViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth_CheckEmailTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title">@Localizer["Auth_CheckEmailTitle"]</h1>
            <p class="auth-subtitle">@Localizer["Auth_CheckEmailText", Model.Email]</p>

            @if (Model.DevConfirmationLink is not null)
            {
                <div class="alert alert-warning small">
                    <strong>@Localizer["Auth_DevEmailTitle"]</strong>
                    @Localizer["Auth_DevEmailText"]
                    <div class="mt-2"><a href="@Model.DevConfirmationLink" class="text-break">@Model.DevConfirmationLink</a></div>
                </div>
            }

            <form asp-action="ResendConfirmation" method="post" class="mt-3">
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-auth">@Localizer["Auth_ResendConfirmation"]</button>
            </form>

            <p class="auth-footer-link">
                <a asp-action="Login">@Localizer["Auth_BackToSignIn"]</a>
            </p>
        </section>
    </div>
</div>
