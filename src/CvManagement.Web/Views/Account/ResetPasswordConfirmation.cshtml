@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Reset_DoneTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title text-success">@Localizer["Reset_DoneTitle"]</h1>
            <p class="auth-subtitle">@Localizer["Reset_DoneText"]</p>
            <a asp-action="Login" class="btn btn-auth">@Localizer["Account_LoginButton"]</a>
        </section>
    </div>
</div>
