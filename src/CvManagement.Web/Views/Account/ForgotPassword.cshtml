@model CvManagement.Web.ViewModels.Account.ForgotPasswordViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Reset_ForgotTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title">@Localizer["Reset_ForgotTitle"]</h1>
            <p class="auth-subtitle">@Localizer["Reset_ForgotSubtitle"]</p>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label visually-hidden">@Localizer["Account_Email"]</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="@Localizer["Account_Email"]" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-auth">@Localizer["Reset_SendLink"]</button>
            </form>

            <p class="auth-footer-link">
                <a asp-action="Login">@Localizer["Auth_BackToSignIn"]</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
