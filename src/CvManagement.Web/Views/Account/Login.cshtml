@model CvManagement.Web.ViewModels.Account.LoginViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Account_LoginTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-4">@Localizer["Account_LoginTitle"]</h1>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">@Localizer["Account_Email"]</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@Localizer["Account_Password"]</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">@Localizer["Account_RememberMe"]</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">@Localizer["Account_LoginButton"]</button>
        </form>

        @if (Model.ExternalLogins.Count > 0)
        {
            <hr class="my-4" />
            <p class="text-secondary small mb-2">@Localizer["Account_OrSignInWith"]</p>
            @foreach (var scheme in Model.ExternalLogins)
            {
                <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="d-inline-block me-2">
                    <input type="hidden" name="provider" value="@scheme.Name" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-outline-secondary">@scheme.DisplayName</button>
                </form>
            }
        }

        <p class="mt-4 small">
            @Localizer["Account_NoAccount"]
            <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Nav_Register"]</a>
        </p>

        <div class="alert alert-light border small mt-3">
            Demo accounts (password <code>Demo@12345</code>):<br />
            candidate@demo.local &middot; recruiter@demo.local &middot; admin@demo.local
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
