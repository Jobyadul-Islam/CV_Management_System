@model CvManagement.Web.ViewModels.Account.RegisterViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Account_RegisterTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title">@Localizer["Account_RegisterTitle"]</h1>
            <p class="auth-subtitle">@Localizer["Auth_RegisterSubtitle"]</p>

            <form asp-controller="Account" asp-action="Register" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row g-2">
                    <div class="col-6 mb-2">
                        <label asp-for="FirstName" class="form-label">@Localizer["Account_FirstName"]</label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-6 mb-2">
                        <label asp-for="LastName" class="form-label">@Localizer["Account_LastName"]</label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-2">
                    <label asp-for="Email" class="form-label">@Localizer["Account_Email"]</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label">@Localizer["Account_Password"]</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label">@Localizer["Account_ConfirmPassword"]</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-auth">@Localizer["Account_RegisterButton"]</button>
            </form>

            <p class="auth-footer-link">
                @Localizer["Account_HaveAccount"]
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Nav_SignIn"]</a>
            </p>
        </section>

        <partial name="_AuthAside" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
