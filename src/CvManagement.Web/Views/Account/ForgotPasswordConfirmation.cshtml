@model CvManagement.Web.ViewModels.Account.ForgotPasswordConfirmationViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth_CheckEmailTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title">@Localizer["Auth_CheckEmailTitle"]</h1>
            @* Deliberately identical whether or not the address is registered (no account enumeration). *@
            <p class="auth-subtitle">@Localizer["Reset_LinkSentText", Model.Email]</p>

            @if (Model.DevResetLink is not null)
            {
                <div class="alert alert-warning small">
                    <strong>@Localizer["Auth_DevEmailTitle"]</strong>
                    @Localizer["Auth_DevEmailText"]
                    <div class="mt-2"><a href="@Model.DevResetLink" class="text-break">@Model.DevResetLink</a></div>
                </div>
            }

            <a asp-action="Login" class="btn btn-auth mt-2">@Localizer["Auth_BackToSignIn"]</a>
        </section>
    </div>
</div>
