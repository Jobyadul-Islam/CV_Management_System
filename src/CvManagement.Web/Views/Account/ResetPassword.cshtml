@model CvManagement.Web.ViewModels.Account.ResetPasswordViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Reset_NewPasswordTitle"];
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card auth-card-single">
        <section class="auth-main">
            <div class="auth-card-top">
                <partial name="_BrandLockup" />
            </div>

            <h1 class="auth-title">@Localizer["Reset_NewPasswordTitle"]</h1>
            <p class="auth-subtitle">@Localizer["Reset_NewPasswordSubtitle", Model.Email]</p>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">@Localizer["Reset_NewPassword"]</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">@Localizer["Account_ConfirmPassword"]</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-auth">@Localizer["Reset_SavePassword"]</button>
            </form>

            <p class="auth-footer-link">
                <a asp-action="ForgotPassword">@Localizer["Reset_RequestNewLink"]</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
