@model CvManagement.Web.ViewModels.Profile.ProjectFormViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ProjectForm_New_Title"];
}

<h1 class="h3 mb-3">@Localizer["ProjectForm_New_Title"]</h1>

<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
</form>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2/dist/easymde.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify@4/dist/tagify.css">
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde@2/dist/easymde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify@4"></script>
    <script src="~/js/markdown-editor-init.js" asp-append-version="true"></script>
}
