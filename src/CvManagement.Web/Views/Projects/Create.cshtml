@model CvManagement.Web.ViewModels.Profile.ProjectFormViewModel
@{
    ViewData["Title"] = "New Project";
}

<h1 class="h3 mb-3">New Project</h1>

<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
</form>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css">
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script src="~/js/markdown-editor-init.js" asp-append-version="true"></script>
}
