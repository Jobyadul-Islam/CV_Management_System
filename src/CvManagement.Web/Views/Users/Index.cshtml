@model IReadOnlyList<CvManagement.Web.ViewModels.Admin.AdminUserListItemViewModel>
@using CvManagement.Web.ViewModels.Shared
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Users_Title"];

    var actions = new List<ToolbarAction>
    {
        new(Localizer["Users_EditRoles"], Url.Action("EditRoles", "Users")! + "/{id}", "get", MinSelected: 1, MaxSelected: 1),
        new(Localizer["Users_Block"], Url.Action("Block", "Users")!, "post", MinSelected: 1, Confirm: Localizer["Users_BlockConfirm"]),
        new(Localizer["Users_Unblock"], Url.Action("Unblock", "Users")!, "post", MinSelected: 1),
        new(Localizer["Common_Delete"], Url.Action("Delete", "Users")!, "post", MinSelected: 1, Confirm: Localizer["Users_DeleteConfirm"], CssClass: "btn-outline-danger")
    };
}

<h1 class="h3 mb-3">@Localizer["Users_Title"]</h1>

@await Component.InvokeAsync("SelectableTableToolbar", new { tableId = "users-table", actions })

<div class="table-responsive">
    <table id="users-table" class="table table-hover align-middle selectable-table" data-toolbar="users-table-toolbar">
        <thead>
            <tr>
                <th style="width:2rem"><input type="checkbox" class="select-all form-check-input" /></th>
                <th>@Localizer["Users_ColName"]</th>
                <th>@Localizer["Users_ColEmail"]</th>
                <th>@Localizer["Users_ColRoles"]</th>
                <th>@Localizer["Users_ColStatus"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr data-id="@user.Id">
                    <td><input type="checkbox" class="row-select form-check-input" value="@user.Id" /></td>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge bg-secondary">@role</span>
                        }
                    </td>
                    <td>
                        @if (user.IsBlocked)
                        {
                            <span class="badge bg-danger">@Localizer["Users_Blocked"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Localizer["Users_Active"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
