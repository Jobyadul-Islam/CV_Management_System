@model List<Position>
@{
    ViewData["Title"] = "Search";
    var query = ViewData["Query"] as string;
}

<h1 class="h3 mb-3">Search results for "@query"</h1>

@if (string.IsNullOrWhiteSpace(query))
{
    <p class="text-secondary">Enter a search term in the header above.</p>
}
else if (Model.Count == 0)
{
    <p class="text-secondary">No positions matched your search.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var position in Model)
                {
                    <tr>
                        <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@position.Id">@position.Title</a></td>
                        <td>@position.Company</td>
                        <td>@position.ShortDescription</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
