@model CvManagement.Web.ViewModels.Home.SearchResultsViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Search_Button"];
}

<h1 class="h3 mb-3">@Localizer["Search_ResultsFor"] "@Model.Query"</h1>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <p class="text-secondary">@Localizer["Search_EnterTerm"]</p>
}
else
{
    <h2 class="h5">@Localizer["Search_Positions"]</h2>
    @if (Model.Positions.Count == 0)
    {
        <p class="text-secondary">@Localizer["Search_NoPositions"]</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead><tr><th>@Localizer["Positions_ColTitle"]</th><th>@Localizer["Positions_ColCompany"]</th><th>@Localizer["Positions_ColLevel"]</th></tr></thead>
                <tbody>
                    @foreach (var position in Model.Positions)
                    {
                        <tr>
                            <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@position.Id">@position.Title</a></td>
                            <td>@position.Company</td>
                            <td>@(position.Level is { } level ? Localizer[$"Level_{level}"] : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (User.IsInRole(CvManagement.Web.Models.RoleNames.Recruiter) || User.IsInRole(CvManagement.Web.Models.RoleNames.Administrator))
    {
        <h2 class="h5">@Localizer["Search_Cvs"]</h2>
        @if (Model.Cvs.Count == 0)
        {
            <p class="text-secondary">@Localizer["Search_NoCvs"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>@Localizer["Cv_ColCandidate"]</th><th>@Localizer["Profile_ColPosition"]</th><th>@Localizer["Profile_ColLikes"]</th></tr></thead>
                    <tbody>
                        @foreach (var cv in Model.Cvs)
                        {
                            <tr>
                                <td><a asp-controller="Cv" asp-action="Details" asp-route-id="@cv.Id">@cv.CandidateDisplayName</a></td>
                                <td>@cv.PositionTitle</td>
                                <td>&#9733; @cv.LikeCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}
