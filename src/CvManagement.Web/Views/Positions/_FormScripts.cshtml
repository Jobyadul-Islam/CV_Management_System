@model CvManagement.Web.ViewModels.Position.PositionFormViewModel
@using CvManagement.Web.Models.Enums
@inject IStringLocalizer<SharedResource> Localizer
@* Rendered from the page's @section Scripts (see Create/Edit), i.e. after the layout's jQuery,
   Bootstrap and shared scripts -- inline in the form they ran too early and crashed. *@
<partial name="_ValidationScriptsPartial" />
<script>
(function () {
    var operatorCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        CvManagement.Web.Models.Enums.OperatorCatalog.AllowedOperators.ToDictionary(
            kv => (int)kv.Key,
            kv => kv.Value.Select(op => new { value = (int)op, label = Localizer[CvManagement.Web.Models.Enums.OperatorCatalog.LabelKey(op)].Value }))));
    var allAttributes = []; // populated after fetching /Attributes/Picker
    var selectedTemplateAttrs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.SelectedAttributes.Select(a => new { id = a.Id, name = a.Name })));
    var existingRules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AccessRules,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    var removeRuleText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PositionForm_RemoveRule"].Value));

    // ---------- Template attribute chips ----------
    var chipsContainer = document.getElementById("templateAttributeChips");
    var inputsContainer = document.getElementById("templateAttributeInputs");

    function renderChips() {
        chipsContainer.innerHTML = "";
        inputsContainer.innerHTML = "";
        selectedTemplateAttrs.forEach(function (attr, idx) {
            var chip = document.createElement("span");
            chip.className = "badge bg-primary d-inline-flex align-items-center gap-1";
            chip.style.fontSize = "0.9rem";
            chip.textContent = attr.name;
            var removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.className = "btn-close btn-close-white btn-sm";
            removeBtn.style.fontSize = "0.6rem";
            removeBtn.addEventListener("click", function () {
                selectedTemplateAttrs.splice(idx, 1);
                renderChips();
            });
            chip.appendChild(removeBtn);
            chipsContainer.appendChild(chip);

            var hidden = document.createElement("input");
            hidden.type = "hidden";
            hidden.name = "AttributeIds[" + idx + "]";
            hidden.value = attr.id;
            inputsContainer.appendChild(hidden);
        });
    }
    renderChips();

    AttributePicker.onConfirm("templateAttributePicker", function (selected) {
        selected.forEach(function (attr) {
            if (!selectedTemplateAttrs.some(function (a) { return a.id === attr.id; })) {
                selectedTemplateAttrs.push({ id: attr.id, name: attr.name });
            }
        });
        renderChips();
    });

    // ---------- Access mode toggling ----------
    var accessModeSelect = document.getElementById("accessModeSelect");
    var rulesSection = document.getElementById("accessRulesSection");
    var restrictedValue = "@((int)PositionAccessMode.Restricted)";
    function refreshAccessMode() {
        rulesSection.style.display = accessModeSelect.value === restrictedValue ? "" : "none";
    }
    accessModeSelect.addEventListener("change", refreshAccessMode);
    refreshAccessMode();

    // ---------- Access rules builder ----------
    var rulesList = document.getElementById("accessRulesList");
    var ruleIndex = 0;

    function attributeOptionsHtml(selectedId) {
        var byCategory = {};
        allAttributes.forEach(function (a) {
            (byCategory[a.categoryName] = byCategory[a.categoryName] || []).push(a);
        });
        var html = "";
        Object.keys(byCategory).sort().forEach(function (cat) {
            html += '<optgroup label="' + cat + '">';
            byCategory[cat].forEach(function (a) {
                html += '<option value="' + a.id + '" data-type="' + a.dataType + '"' + (a.id === selectedId ? " selected" : "") + '>' + a.name + '</option>';
            });
            html += '</optgroup>';
        });
        return html;
    }

    function addRuleRow(rule) {
        var idx = ruleIndex++;
        var row = document.createElement("div");
        row.className = "row g-2 align-items-start mb-2 rule-row";
        row.innerHTML =
            '<div class="col-md-3"><select class="form-select rule-attribute" name="AccessRules[' + idx + '].AttributeId">' +
                attributeOptionsHtml(rule ? rule.attributeId : null) + '</select></div>' +
            '<div class="col-md-2"><select class="form-select rule-operator" name="AccessRules[' + idx + '].Operator"></select></div>' +
            '<div class="col-md-5 rule-value-container"></div>' +
            '<div class="col-md-2"><button type="button" class="btn btn-outline-danger btn-sm remove-rule-btn"></button></div>';
        rulesList.appendChild(row);
        row.querySelector(".remove-rule-btn").textContent = removeRuleText;

        var attrSelect = row.querySelector(".rule-attribute");
        var opSelect = row.querySelector(".rule-operator");
        var valueContainer = row.querySelector(".rule-value-container");

        function currentAttr() {
            var id = parseInt(attrSelect.value, 10);
            return allAttributes.filter(function (a) { return a.id === id; })[0];
        }

        function refreshOperators() {
            var attr = currentAttr();
            if (!attr) return;
            var ops = operatorCatalog[attr.dataType] || [];
            opSelect.innerHTML = ops.map(function (o) { return '<option value="' + o.value + '">' + o.label + '</option>'; }).join("");
            if (rule && rule.operator !== undefined) { opSelect.value = rule.operator; }
            refreshValueInput();
        }

        function refreshValueInput() {
            var attr = currentAttr();
            var op = parseInt(opSelect.value, 10);
            valueContainer.innerHTML = "";
            // IsSet(10)/IsNotSet(11)/IsTrue(8)/IsFalse(9) need no value.
            if ([8, 9, 10, 11].indexOf(op) !== -1 || !attr) return;

            if (attr.dataType === 7) { // OneOfMany
                var sel = document.createElement("select");
                sel.className = "form-select";
                sel.name = "AccessRules[" + idx + "].ComparisonOptionId";
                (attr.options || []).forEach(function (o) {
                    var opt = document.createElement("option");
                    opt.value = o.id; opt.textContent = o.label;
                    if (rule && rule.comparisonOptionId === o.id) opt.selected = true;
                    sel.appendChild(opt);
                });
                valueContainer.appendChild(sel);
            } else if (attr.dataType === 3) { // Numeric
                var num = document.createElement("input");
                num.type = "number"; num.step = "any"; num.className = "form-control";
                num.name = "AccessRules[" + idx + "].ComparisonValueNumeric";
                if (rule && rule.comparisonValueNumeric !== undefined) num.value = rule.comparisonValueNumeric;
                valueContainer.appendChild(num);
            } else if (attr.dataType === 4) { // Date
                var dt = document.createElement("input");
                dt.type = "date"; dt.className = "form-control";
                dt.name = "AccessRules[" + idx + "].ComparisonValueDate";
                if (rule && rule.comparisonValueDate) dt.value = rule.comparisonValueDate.substring(0, 10);
                valueContainer.appendChild(dt);
            } else {
                var txt = document.createElement("input");
                txt.type = "text"; txt.className = "form-control";
                txt.name = "AccessRules[" + idx + "].ComparisonValueString";
                if (rule && rule.comparisonValueString) txt.value = rule.comparisonValueString;
                valueContainer.appendChild(txt);
            }
        }

        attrSelect.addEventListener("change", refreshOperators);
        opSelect.addEventListener("change", refreshValueInput);
        row.querySelector(".remove-rule-btn").addEventListener("click", function () { row.remove(); });

        refreshOperators();
    }

    document.getElementById("addRuleBtn").addEventListener("click", function () { addRuleRow(null); });

    // ---------- Project tags ----------
    var tagsInput = document.getElementById("projectTagsInput");
    var tagsHidden = document.getElementById("projectTagsHidden");
    function syncTagsHidden() {
        tagsHidden.innerHTML = "";
        tagsInput.value.split(",").map(function (t) { return t.trim(); }).filter(function (t) { return t.length > 0; })
            .forEach(function (tag, i) {
                var input = document.createElement("input");
                input.type = "hidden"; input.name = "ProjectTags[" + i + "]"; input.value = tag;
                tagsHidden.appendChild(input);
            });
    }
    tagsInput.closest("form").addEventListener("submit", syncTagsHidden);

    // ---------- Load full attribute list (for rule builder), then render existing rules ----------
    fetch("/Attributes/Picker")
        .then(function (r) { return r.json(); })
        .then(function (data) {
            allAttributes = data.results.map(function (a) {
                return { id: a.id, name: a.name, categoryName: a.categoryName, dataType: a.dataType, options: a.options };
            });
            existingRules.forEach(function (r) { addRuleRow(r); });
        });
})();
</script>
