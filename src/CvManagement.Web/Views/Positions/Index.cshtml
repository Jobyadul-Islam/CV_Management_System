@model IReadOnlyList<CvManagement.Web.ViewModels.Position.PositionListItemViewModel>
@using CvManagement.Web.ViewModels.Shared
@{
    ViewData["Title"] = "Positions";
    var isManaging = (bool)ViewBag.IsManaging;

    var actions = new List<ToolbarAction>
    {
        new("Edit", Url.Action("Edit", "Positions")! + "/{id}", "get", MinSelected: 1, MaxSelected: 1),
        new("Duplicate", Url.Action("Duplicate", "Positions")!, "post", MinSelected: 1, MaxSelected: 1),
        new("Delete", Url.Action("Delete", "Positions")!, "post", MinSelected: 1, Confirm: "Delete the selected position(s)? Positions with existing CVs will be skipped.", CssClass: "btn-outline-danger")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Positions</h1>
    @if (isManaging)
    {
        <a asp-action="Create" class="btn btn-primary">+ New Position</a>
    }
</div>

@if (isManaging)
{
    @await Component.InvokeAsync("SelectableTableToolbar", new { tableId = "positions-table", actions })
}

<div class="table-responsive">
    <table id="positions-table" class="table table-hover align-middle @(isManaging ? "selectable-table" : "")" data-toolbar="positions-table-toolbar">
        <thead>
            <tr>
                @if (isManaging)
                {
                    <th style="width:2rem"><input type="checkbox" class="select-all form-check-input" /></th>
                }
                <th>Title</th>
                <th>Company</th>
                <th>Level</th>
                <th>Access</th>
                @if (isManaging)
                {
                    <th>CVs</th>
                }
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id">
                    @if (isManaging)
                    {
                        <td><input type="checkbox" class="row-select form-check-input" value="@item.Id" /></td>
                    }
                    <td><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                    <td>@item.Company</td>
                    <td>@item.Level</td>
                    <td>
                        @if (item.AccessMode == CvManagement.Web.Domain.Enums.PositionAccessMode.Public)
                        {
                            <span class="badge bg-success">Public</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Restricted</span>
                        }
                    </td>
                    @if (isManaging)
                    {
                        <td>@item.CvCount</td>
                    }
                    <td>@item.UpdatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-4">No positions to show.</td></tr>
            }
        </tbody>
    </table>
</div>
