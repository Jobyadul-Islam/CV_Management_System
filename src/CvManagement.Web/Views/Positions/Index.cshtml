@model IReadOnlyList<CvManagement.Web.ViewModels.Position.PositionListItemViewModel>
@using CvManagement.Web.ViewModels.Shared
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Nav_Positions"];
    var isManaging = (bool)ViewBag.IsManaging;

    var actions = new List<ToolbarAction>
    {
        new(Localizer["Common_Edit"], Url.Action("Edit", "Positions")! + "/{id}", "get", MinSelected: 1, MaxSelected: 1),
        new(Localizer["Common_Duplicate"], Url.Action("Duplicate", "Positions")!, "post", MinSelected: 1, MaxSelected: 1),
        new(Localizer["Common_Delete"], Url.Action("Delete", "Positions")!, "post", MinSelected: 1, Confirm: Localizer["Positions_DeleteConfirm"], CssClass: "btn-outline-danger")
    };
}

@{
    var tagFilter = (string?)ViewBag.Tag;
}
@if (!string.IsNullOrWhiteSpace(tagFilter))
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>@Localizer["Positions_FilteredByTag"] <strong>@tagFilter</strong></span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["Common_Clear"]</a>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Localizer["Nav_Positions"]</h1>
    @if (isManaging)
    {
        <a asp-action="Create" class="btn btn-primary">@Localizer["Positions_New"]</a>
    }
</div>

@if (isManaging)
{
    @await Component.InvokeAsync("SelectableTableToolbar", new { tableId = "positions-table", actions })
}

<div class="table-responsive">
    <table id="positions-table" class="table table-hover align-middle @(isManaging ? "selectable-table" : "")" data-toolbar="positions-table-toolbar">
        <thead>
            <tr>
                @if (isManaging)
                {
                    <th style="width:2rem"><input type="checkbox" class="select-all form-check-input" /></th>
                }
                <th>@Localizer["Positions_ColTitle"]</th>
                <th>@Localizer["Positions_ColCompany"]</th>
                <th>@Localizer["Positions_ColLevel"]</th>
                <th>@Localizer["Positions_ColAccess"]</th>
                @if (isManaging)
                {
                    <th>@Localizer["Positions_ColCvs"]</th>
                }
                <th>@Localizer["Common_Updated"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id">
                    @if (isManaging)
                    {
                        <td><input type="checkbox" class="row-select form-check-input" value="@item.Id" /></td>
                    }
                    <td><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                    <td>@item.Company</td>
                    <td>@item.Level</td>
                    <td>
                        @if (item.AccessMode == CvManagement.Web.Domain.Enums.PositionAccessMode.Public)
                        {
                            <span class="badge bg-success">@Localizer["Positions_Public"]</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@Localizer["Positions_Restricted"]</span>
                        }
                    </td>
                    @if (isManaging)
                    {
                        <td>@item.CvCount</td>
                    }
                    <td>@item.UpdatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-4">@Localizer["Positions_Empty"]</td></tr>
            }
        </tbody>
    </table>
</div>
