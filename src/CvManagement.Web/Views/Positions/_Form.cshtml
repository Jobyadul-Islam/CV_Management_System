@model CvManagement.Web.ViewModels.Position.PositionFormViewModel
@using CvManagement.Web.Models.Enums
@inject IStringLocalizer<SharedResource> Localizer

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" />
    </div>
</div>

<div class="mb-3">
    <label asp-for="ShortDescription" class="form-label"></label>
    <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Level" class="form-label"></label>
        <select asp-for="Level" asp-items="Model.LevelOptions" class="form-select"></select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MaxProjects" class="form-label"></label>
        <input asp-for="MaxProjects" type="number" min="1" max="20" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="AccessMode" class="form-label"></label>
        <select asp-for="AccessMode" asp-items="Html.GetEnumSelectList<PositionAccessMode>()" class="form-select" id="accessModeSelect"></select>
    </div>
</div>

<hr class="my-4" />

<h2 class="h5">@Localizer["PositionForm_TemplateAttributes"]</h2>
<p class="text-secondary small">@Localizer["PositionForm_TemplateAttributesHelp"]</p>
<div id="templateAttributeChips" class="mb-2 d-flex flex-wrap gap-2"></div>
<div id="templateAttributeInputs"></div>
<button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#templateAttributePicker">@Localizer["PositionForm_AddAttribute"]</button>

@await Component.InvokeAsync("AttributePicker", new { modalId = "templateAttributePicker" })

<hr class="my-4" />

<div id="accessRulesSection" style="display:none">
    <h2 class="h5">@Localizer["PositionForm_AccessRules"]</h2>
    <p class="text-secondary small">@Localizer["PositionForm_AccessRulesHelp"]</p>
    <div id="accessRulesList"></div>
    <button type="button" id="addRuleBtn" class="btn btn-sm btn-outline-secondary">@Localizer["PositionForm_AddRule"]</button>
</div>

<hr class="my-4" />

<h2 class="h5">@Localizer["PositionForm_ProjectTags"]</h2>
<p class="text-secondary small">@Localizer["PositionForm_ProjectTagsHelp"]</p>
<div class="mb-3">
    <input type="text" id="projectTagsInput" class="form-control" placeholder="@Localizer["PositionForm_TagsPlaceholder"]"
           value="@string.Join(", ", Model.ProjectTags)" />
</div>
<div id="projectTagsHidden"></div>

<button type="submit" class="btn btn-primary">@Localizer["Common_Save"]</button>
<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Common_Cancel"]</a>
