@model CvManagement.Web.ViewModels.Profile.AttributeValueViewModel
@inject IConfiguration Configuration
@{
    var cloudName = Configuration["Cloudinary:CloudName"];
    var preset = Configuration["Cloudinary:UnsignedUploadPreset"];
    var configured = !string.IsNullOrWhiteSpace(cloudName) && !string.IsNullOrWhiteSpace(preset);
}
<div class="d-flex align-items-center gap-3">
    <img class="image-preview rounded border bg-body-secondary"
         src="@Model.ValueImageUrl"
         style="width:72px;height:72px;object-fit:cover;@(string.IsNullOrEmpty(Model.ValueImageUrl) ? "display:none" : "")" />
    <input type="hidden" class="autosave-input image-url-input" value="@Model.ValueImageUrl" />
    @if (configured)
    {
        <button type="button" class="btn btn-sm btn-outline-secondary cloudinary-upload-btn"
                data-cloud-name="@cloudName" data-upload-preset="@preset">
            Upload photo
        </button>
    }
    else
    {
        <span class="text-secondary small">Image upload isn't configured yet (needs a Cloudinary cloud name + unsigned upload preset in appsettings).</span>
    }
</div>
