@model CvManagement.Web.ViewModels.Profile.AttributeValueViewModel
@using CvManagement.Web.Domain.Enums
@inject IConfiguration Configuration

<div class="autosave-field mb-4" data-attribute-id="@Model.AttributeId" data-type="@((int)Model.DataType)" data-row-version="@Model.RowVersion">
    <label class="form-label fw-semibold">
        @Model.AttributeName
        @if (Model.IsEmpty)
        {
            <span class="badge bg-danger ms-1">empty</span>
        }
    </label>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="form-text mt-0 mb-1">@Model.Description</div>
    }

    @switch (Model.DataType)
    {
        case AttributeDataType.String:
            <input type="text" class="form-control autosave-input @(Model.IsEmpty ? "border-danger" : "")" value="@Model.ValueString"
                   minlength="@Model.MinLength" maxlength="@Model.MaxLength" pattern="@Model.RegexPattern" />
            break;

        case AttributeDataType.Text:
            <textarea class="form-control autosave-input markdown-editor @(Model.IsEmpty ? "border-danger" : "")" rows="4"
                      minlength="@Model.MinLength" maxlength="@Model.MaxLength">@Model.ValueText</textarea>
            break;

        case AttributeDataType.Image:
            <partial name="_ImageUploadWidget" model="Model" />
            break;

        case AttributeDataType.Numeric:
            <input type="number" step="any" class="form-control autosave-input @(Model.IsEmpty ? "border-danger" : "")" value="@Model.ValueNumeric"
                   min="@Model.MinValue" max="@Model.MaxValue" />
            break;

        case AttributeDataType.Date:
            <input type="date" class="form-control autosave-input @(Model.IsEmpty ? "border-danger" : "")" value="@(Model.ValueDate?.ToString("yyyy-MM-dd"))" />
            break;

        case AttributeDataType.Period:
            <div class="row g-2">
                <div class="col">
                    <input type="date" class="form-control period-start @(Model.IsEmpty ? "border-danger" : "")" value="@(Model.ValuePeriodStart?.ToString("yyyy-MM-dd"))" placeholder="Start" />
                </div>
                <div class="col">
                    <input type="date" class="form-control period-end" value="@(Model.ValuePeriodEnd?.ToString("yyyy-MM-dd"))" placeholder="End" />
                </div>
            </div>
            break;

        case AttributeDataType.Boolean:
            <div class="form-check">
                <input type="checkbox" class="form-check-input autosave-input" @(Model.ValueBoolean == true ? "checked" : "") />
                <label class="form-check-label small text-secondary">@(Model.ValueBoolean == true ? "Yes" : Model.ValueBoolean == false ? "No" : "Not answered")</label>
            </div>
            break;

        case AttributeDataType.OneOfMany:
            <select class="form-select autosave-input @(Model.IsEmpty ? "border-danger" : "")">
                <option value="">-- select --</option>
                @foreach (var option in Model.Options)
                {
                    <option value="@option.Id" selected="@(option.Id == Model.ValueOptionId)">@option.Label</option>
                }
            </select>
            break;
    }

    <div class="autosave-conflict alert alert-warning py-1 px-2 small mt-2 mb-0" hidden>
        Changed elsewhere since you loaded this page.
        <button type="button" class="btn btn-sm btn-outline-warning autosave-conflict-keep">Keep mine</button>
        <button type="button" class="btn btn-sm btn-outline-secondary autosave-conflict-reload">Reload page</button>
    </div>
    <div class="autosave-status small text-secondary"></div>
</div>
