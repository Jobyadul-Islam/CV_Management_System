@model CvManagement.Web.ViewModels.Profile.AttributeValueViewModel
@using CvManagement.Web.Models.Enums
@inject IStringLocalizer<SharedResource> Localizer

<div class="autosave-field mb-4" data-attribute-id="@Model.AttributeId" data-type="@((int)Model.DataType)" data-row-version="@Model.RowVersion" data-empty="@(Model.IsEmpty ? "true" : "false")" data-optional="@(Model.IsOptional ? "true" : "false")">
    <label class="form-label fw-semibold">
        @Model.AttributeName
        @* Always rendered; autosave.js toggles it as the value is filled in or cleared. *@
        <span class="badge bg-danger ms-1 autosave-empty-badge" @(Model.NeedsValue ? "" : "hidden")>@Localizer["Autosave_Empty"]</span>
        @if (Model.IsOptional)
        {
            <span class="badge text-bg-light border ms-1 fw-normal">@Localizer["Field_OptionalBadge"]</span>
        }
    </label>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="form-text mt-0 mb-1">@Model.Description</div>
    }

    @switch (Model.DataType)
    {
        case AttributeDataType.String:
            <input type="text" class="form-control autosave-input @(Model.NeedsValue ? "border-danger" : "")" value="@Model.ValueString"
                   minlength="@Model.MinLength" maxlength="@Model.MaxLength" pattern="@Model.RegexPattern" />
            break;

        case AttributeDataType.Text:
            <textarea class="form-control autosave-input markdown-editor @(Model.NeedsValue ? "border-danger" : "")" rows="4"
                      minlength="@Model.MinLength" maxlength="@Model.MaxLength">@Model.ValueText</textarea>
            break;

        case AttributeDataType.Image:
            <partial name="_ImageUploadWidget" model="Model" />
            break;

        case AttributeDataType.Numeric:
            <input type="number" step="any" class="form-control autosave-input @(Model.NeedsValue ? "border-danger" : "")" value="@Model.ValueNumeric"
                   min="@Model.MinValue" max="@Model.MaxValue" />
            break;

        case AttributeDataType.Date:
            <input type="date" class="form-control autosave-input @(Model.NeedsValue ? "border-danger" : "")" value="@(Model.ValueDate?.ToString("yyyy-MM-dd"))" />
            break;

        case AttributeDataType.Period:
            <div class="row g-2">
                <div class="col">
                    <input type="date" class="form-control period-start @(Model.NeedsValue ? "border-danger" : "")" value="@(Model.ValuePeriodStart?.ToString("yyyy-MM-dd"))" placeholder="@Localizer["Autosave_PeriodStart"]" />
                </div>
                <div class="col">
                    <input type="date" class="form-control period-end" value="@(Model.ValuePeriodEnd?.ToString("yyyy-MM-dd"))" placeholder="@Localizer["Autosave_PeriodEnd"]" />
                </div>
            </div>
            break;

        case AttributeDataType.Boolean:
            <div class="form-check">
                <input type="checkbox" class="form-check-input autosave-input" @(Model.ValueBoolean == true ? "checked" : "") />
                <label class="form-check-label small text-secondary">@(Model.ValueBoolean == true ? Localizer["Common_Yes"] : Model.ValueBoolean == false ? Localizer["Common_No"] : Localizer["Autosave_NotAnswered"])</label>
            </div>
            break;

        case AttributeDataType.OneOfMany:
            <select class="form-select autosave-input @(Model.NeedsValue ? "border-danger" : "")">
                <option value="">@Localizer["Autosave_Select"]</option>
                @foreach (var option in Model.Options)
                {
                    <option value="@option.Id" selected="@(option.Id == Model.ValueOptionId)">@option.Label</option>
                }
            </select>
            break;
    }

    <div class="autosave-conflict alert alert-warning py-1 px-2 small mt-2 mb-0" hidden>
        @Localizer["Autosave_ChangedElsewhere"]
        <button type="button" class="btn btn-sm btn-outline-warning autosave-conflict-keep">@Localizer["Autosave_KeepMine"]</button>
        <button type="button" class="btn btn-sm btn-outline-secondary autosave-conflict-reload">@Localizer["Autosave_ReloadPage"]</button>
    </div>
    <div class="autosave-status small text-secondary"></div>
</div>
