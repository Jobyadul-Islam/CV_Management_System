@inject IStringLocalizer<SharedResource> Localizer
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            @User.Identity.Name
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (User.IsInRole(RoleNames.Candidate) || User.IsInRole(RoleNames.Administrator))
            {
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">@Localizer["Nav_MyProfile"]</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">@Localizer["Nav_SignOut"]</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link header-signin" asp-controller="Account" asp-action="Login">@Localizer["Nav_SignIn"]</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-brand ms-lg-2" asp-controller="Account" asp-action="Register">@Localizer["Nav_GetStarted"]</a>
    </li>
}
