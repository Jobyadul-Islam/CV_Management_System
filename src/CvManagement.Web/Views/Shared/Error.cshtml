@model ErrorViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Error_Title"];
}

<h1 class="text-danger">@Localizer["Error_Title"]</h1>
<h2 class="h5 text-danger">@Localizer["Error_Message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}
