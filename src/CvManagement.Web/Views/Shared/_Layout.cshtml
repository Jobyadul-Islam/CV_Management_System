@inject IStringLocalizer<SharedResource> Localizer
@{
    var theme = Context.Request.Cookies["CvManagement.Theme"] == "dark" ? "dark" : "light";
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var isAdmin = User.IsInRole(RoleNames.Administrator);
    var isRecruiter = User.IsInRole(RoleNames.Recruiter) || isAdmin;
    var isCandidate = User.IsInRole(RoleNames.Candidate) || isAdmin;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CV Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg border-bottom mb-3 sticky-top bg-body">
            <div class="container-fluid flex-wrap">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">CV Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Positions" asp-action="Index">@Localizer["Nav_Positions"]</a>
                        </li>
                        @if (isCandidate)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">@Localizer["Nav_MyProfile"]</a>
                            </li>
                        }
                        @if (isRecruiter)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Attributes" asp-action="Index">@Localizer["Nav_AttributeLibrary"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cv" asp-action="Browse">@Localizer["Nav_BrowseCvs"]</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Index">@Localizer["Nav_Users"]</a>
                            </li>
                        }
                    </ul>

                    <form asp-controller="Search" asp-action="Index" method="get" class="d-flex site-search-form mx-lg-3 my-2 my-lg-0" role="search">
                        <input type="search" name="q" class="form-control" placeholder="@Localizer["Search_Placeholder"]" aria-label="@Localizer["Search_Button"]" value="@ViewData["Query"]" />
                    </form>

                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <button id="theme-toggle-btn" type="button" class="btn btn-link nav-link" title="@Localizer["Theme_Toggle"]">
                                <span id="theme-toggle-icon">@(theme == "dark" ? "☀️" : "\U0001F319")</span>
                            </button>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpperInvariant()
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form asp-controller="Culture" asp-action="SetCulture" method="post">
                                        <input type="hidden" name="culture" value="en" />
                                        <input type="hidden" name="returnUrl" value="@currentPath" />
                                        <button type="submit" class="dropdown-item">English</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Culture" asp-action="SetCulture" method="post">
                                        <input type="hidden" name="culture" value="ru" />
                                        <input type="hidden" name="returnUrl" value="@currentPath" />
                                        <button type="submit" class="dropdown-item">Русский</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main class="pb-4">
            @if (TempData["StatusMessage"] is string status)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @status
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 mt-4 text-secondary">
        <div class="container">
            <small>&copy; 2026 &middot; @Localizer["Footer_Text"]</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/table-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/attribute-picker.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
