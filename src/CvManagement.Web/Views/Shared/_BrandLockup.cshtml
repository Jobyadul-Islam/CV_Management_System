@* App logo: a gradient tile holding a CV sheet, plus a two-line wordmark. Used in the header and on
   the auth cards. Pure inline SVG -- no image asset, and the gradient ids are unique per instance. *@
@{
    var gradientId = "brandGrad" + Guid.NewGuid().ToString("N")[..6];
}
<a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="CV Management System">
    <svg width="38" height="38" viewBox="0 0 38 38" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="@gradientId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ff9a1f" />
                <stop offset=".45" stop-color="#ee3f2d" />
                <stop offset="1" stop-color="#c2185b" />
            </linearGradient>
        </defs>
        <rect x="1" y="1" width="36" height="36" rx="10" fill="url(#@gradientId)" />
        <path d="M12 9h10l5 5v15a1.5 1.5 0 0 1-1.5 1.5h-13.5A1.5 1.5 0 0 1 10.5 29V10.5A1.5 1.5 0 0 1 12 9z" fill="#fff" />
        <path d="M22 9v4.2c0 .45.35.8.8.8H27" fill="none" stroke="#f3b3a6" stroke-width="1.2" />
        <circle cx="15.5" cy="16" r="2.2" fill="#ee3f2d" />
        <rect x="14" y="21" width="9.5" height="1.6" rx=".8" fill="#c9c9cf" />
        <rect x="14" y="24.5" width="7" height="1.6" rx=".8" fill="#c9c9cf" />
    </svg>
    <span class="brand-text">
        <span class="brand-top">CV</span>
        <span class="brand-bottom">Management</span>
    </span>
</a>
