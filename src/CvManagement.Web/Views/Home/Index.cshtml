@model CvManagement.Web.ViewModels.Home.HomeIndexViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "CV Management System";
    var isRecruiter = User.IsInRole(CvManagement.Web.Models.RoleNames.Recruiter) || User.IsInRole(CvManagement.Web.Models.RoleNames.Administrator);
    var maxTagCount = Model.TagCloud.Count > 0 ? Model.TagCloud.Max(t => t.Count) : 1;
}

@section Hero {
    <section class="hero">
        <div class="container hero-inner">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-eyebrow">@Localizer["Hero_Eyebrow"]</div>
                    <h1 class="hero-title">@Localizer["Hero_Title"]</h1>
                    <p class="hero-text">@Localizer["Hero_Text"]</p>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-hero">@Localizer["Hero_CtaGuest"]</a>
                    }
                    else if (isRecruiter)
                    {
                        <a asp-controller="Positions" asp-action="Create" class="btn btn-hero">@Localizer["Hero_CtaRecruiter"]</a>
                    }
                    else
                    {
                        <a asp-controller="Positions" asp-action="Index" class="btn btn-hero">@Localizer["Hero_CtaCandidate"]</a>
                    }
                </div>
                <div class="col-lg-6">
                    <partial name="_HeroArt" />
                </div>
            </div>
        </div>
    </section>
}

<h2 class="h5 visually-hidden">@Localizer["Home_Stats"]</h2>
<div class="row mb-4 g-3 text-center">
    <div class="col-6 col-md">
        <div class="stat-tile">
            <div class="stat-value">@Model.Stats.CvsCreatedLast24h</div>
            <div class="stat-label">@Localizer["Home_StatCvs24h"]</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-tile">
            <div class="stat-value">@Model.Stats.TotalPositions</div>
            <div class="stat-label">@Localizer["Nav_Positions"]</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-tile">
            <div class="stat-value">@Model.Stats.TotalCandidates</div>
            <div class="stat-label">@Localizer["Home_StatCandidates"]</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-tile">
            <div class="stat-value">@Model.Stats.TotalRecruiters</div>
            <div class="stat-label">@Localizer["Home_StatRecruiters"]</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-tile">
            <div class="stat-value">@Model.Stats.TotalCvs</div>
            <div class="stat-label">@Localizer["Home_StatSubmittedCvs"]</div>
        </div>
    </div>
</div>

@{
    var levelPoints = Model.PositionsByLevel
        .Select(p => new CvManagement.Web.ViewModels.Home.ChartPoint(Localizer[$"Level_{p.Label}"].Value, p.Value))
        .ToList();
}
@* Two single-series bar charts (Chart.js). One series each, so no legend -- the heading names it; every
   chart also has its numbers as a table (visually hidden, read by screen readers). *@
<div class="row mb-4 g-3">
    <div class="col-lg-7">
        <div class="stat-tile p-3">
            <h2 class="h6 mb-2" id="cvsPerDayTitle">@Localizer["Home_ChartCvsPerDay"]</h2>
            <div style="position:relative;height:220px">
                <canvas class="home-chart" aria-labelledby="cvsPerDayTitle" role="img"
                        data-points="@System.Text.Json.JsonSerializer.Serialize(Model.CvsPerDay)"
                        data-series-label="@Localizer["Home_ChartCvsSeries"]"></canvas>
            </div>
            <partial name="_ChartDataTable" model="Model.CvsPerDay" />
        </div>
    </div>
    <div class="col-lg-5">
        <div class="stat-tile p-3">
            <h2 class="h6 mb-2" id="positionsByLevelTitle">@Localizer["Home_ChartPositionsByLevel"]</h2>
            <div style="position:relative;height:220px">
                <canvas class="home-chart" aria-labelledby="positionsByLevelTitle" role="img" data-horizontal="true"
                        data-points="@System.Text.Json.JsonSerializer.Serialize(levelPoints)"
                        data-series-label="@Localizer["Nav_Positions"]"></canvas>
            </div>
            <partial name="_ChartDataTable" model="levelPoints" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <h2 class="h5">@Localizer["Home_LatestPositions"]</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>@Localizer["Positions_ColTitle"]</th><th>@Localizer["Positions_ColCompany"]</th><th>@Localizer["Common_Updated"]</th></tr></thead>
                <tbody>
                    @foreach (var position in Model.LatestPositions)
                    {
                        <tr>
                            <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@position.Id">@position.Title</a></td>
                            <td>@position.Company</td>
                            <td>@position.UpdatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    @if (Model.LatestPositions.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-secondary py-3">@Localizer["Positions_Empty"]</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <h2 class="h5 mt-4">@Localizer["Home_PopularPositions"]</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>@Localizer["Positions_ColTitle"]</th><th>@Localizer["Positions_ColCompany"]</th><th>@Localizer["Positions_ColCvs"]</th></tr></thead>
                <tbody>
                    @foreach (var position in Model.PopularPositions)
                    {
                        <tr>
                            <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@position.Id">@position.Title</a></td>
                            <td>@position.Company</td>
                            <td>@position.CvCount</td>
                        </tr>
                    }
                    @if (Model.PopularPositions.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-secondary py-3">@Localizer["Positions_Empty"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-5 mb-4">
        <h2 class="h5">@Localizer["Home_TagCloud"]</h2>
        @if (Model.TagCloud.Count == 0)
        {
            <p class="text-secondary">@Localizer["Home_TagCloud_Empty"]</p>
        }
        else
        {
            <div class="tag-cloud">
                @foreach (var tag in Model.TagCloud)
                {
                    var size = 0.85 + (tag.Count / (double)maxTagCount) * 1.15;
                    <a style="font-size:@(size.ToString("0.00"))rem"
                       asp-controller="@(isRecruiter ? "Cv" : "Positions")"
                       asp-action="@(isRecruiter ? "Browse" : "Index")"
                       asp-route-tag="@tag.Name">@tag.Name</a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/home-charts.js" asp-append-version="true"></script>
}
