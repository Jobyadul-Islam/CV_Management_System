@model List<CvManagement.Web.ViewModels.Cv.CvBrowseItemViewModel>
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Cv_Browse_Title"];
}

<h1 class="h3 mb-3">@Localizer["Cv_Browse_Title"]</h1>

@{
    var tagFilter = (string?)ViewBag.Tag;
}
@if (!string.IsNullOrWhiteSpace(tagFilter))
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>@Localizer["Positions_FilteredByTag"] <strong>@tagFilter</strong></span>
        <a asp-action="Browse" class="btn btn-sm btn-outline-secondary">@Localizer["Common_Clear"]</a>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@Localizer["Cv_ColCandidate"]</th>
                <th>@Localizer["Profile_ColPosition"]</th>
                <th>@Localizer["Profile_ColLikes"]</th>
                <th>@Localizer["Common_Updated"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@item.Id">@item.CandidateDisplayName</a></td>
                    <td>@item.PositionTitle</td>
                    <td>&#9733; @item.LikeCount</td>
                    <td>@item.UpdatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">@Localizer["Cv_Browse_Empty"]</td></tr>
            }
        </tbody>
    </table>
</div>
